{% extends 'base.html.twig' %}

{% block title %}Projekte — Portfolio{% endblock %}

{% block body %}
    <section class="hero" style="padding-bottom: 24px;">
        <span class="hero__eyebrow">projects --status</span>
        <h1 class="hero__title" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">Projekt-Log</h1>
        <p class="hero__subtitle" style="margin-bottom: 0;">
            Hier sind alle Projekte, die entweder länger als eine Woche gedauert haben, oder die ich aus anderen Gründen andersweitig stolz drauf bin.
        </p>
    </section>

    <div class="status-feed">
        {% for project in projects %}

            <article
                class="status-card {{ project.category == 'privat' ? 'status-card--private' : '' }}"
                data-project-card
            >
                <div class="status-card__thumb">
                    <img
                        src="{{ project.thumbnail|default('/images/projects/placeholder.jpg') }}"
                        alt="{{ project.title }}"
                        loading="lazy"
                    >
                </div>

                <div class="status-card__body">
                    <div class="status-card__meta">
                        <span class="status-card__id">
                            SYS-{{ '%02d'|format(loop.index) }}
                        </span>

                        <span class="status-card__badge">
                            <span class="status-card__dot"></span>
                            {{ project.category }}
                        </span>
                    </div>

                    <h3 class="status-card__title">
                        {{ project.title }}
                    </h3>

                    <p class="status-card__desc">
                        {{ project.description }}
                    </p>

                    {% if project.content|default([])|length > 0 %}
                        <button
                            type="button"
                            class="status-card__toggle"
                            onclick="document.getElementById('project-{{ loop.index }}').showModal()"
                        >
                            Mehr anzeigen
                        </button>
                    {% endif %}
                </div>
            </article>

            {% if project.content|default([])|length > 0 %}
                <dialog id="project-{{ loop.index }}" class="project-modal">
                    <div class="project-modal__header">
                        <div>
                            <small>{{ project.category }}</small>
                            <h2>{{ project.title }}</h2>
                        </div>

                        <button
                            type="button"
                            onclick="this.closest('dialog').close()"
                        >
                            ×
                        </button>
                    </div>

                    <div class="project-modal__content">
                        {% for item in project.content %}

                            {% if item.type == 'heading' %}
                                <h3>{{ item.text }}</h3>

                            {% elseif item.type == 'text' %}
                                <p>{{ item.text }}</p>

                            {% elseif item.type == 'image' %}
                                <img
                                    src="{{ item.src }}"
                                    alt="{{ item.alt|default('') }}"
                                >

                            {% elseif item.type == 'video' %}
                                <video controls>
                                    <source src="{{ item.src }}" type="video/mp4">
                                    Dein Browser unterstützt dieses Videoformat nicht.
                                 </video>

                            {% elseif item.type == 'pdf' %}
                                <iframe src="{{ item.src }}"></iframe>
                            {% endif %}

                        {% endfor %}
                    </div>
                </dialog>
            {% endif %}

        {% endfor %}
    </div>
{% endblock %}