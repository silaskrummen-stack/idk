<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#221654">
    <title>LAN Night · Mitmachen</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="{{ lan_asset('lan.css') }}">
    <link rel="stylesheet" href="{{ lan_asset('quiz.css') }}">
</head>
<body class="phone">

<header class="phead">
    <span class="phead__title" id="title">LAN Night</span>
    <button class="phead__team" id="myTeam" hidden></button>
</header>

<main class="pmain">
    {# Team wählen (wird auf dem Handy gemerkt) #}
    <section class="view" id="viewTeam" hidden>
        <p class="view__eyebrow">Willkommen zum Quiz</p>
        <h1 class="view__title">In welchem Team bist du?</h1>
        <div class="team-pick" id="teamPick"></div>
    </section>

    {# Warten #}
    <section class="view view--center" id="viewWait" hidden>
        <div class="spinner" aria-hidden="true"></div>
        <h1 class="view__title" id="waitTitle">Gleich geht's los</h1>
        <p class="view__text" id="waitText">Die nächste Frage erscheint hier automatisch.</p>
    </section>

    {# Frage #}
    <section class="view" id="viewQuestion" hidden>
        <div class="qhead">
            <span class="view__eyebrow" id="qNum"></span>
            <span class="qtimer" id="qTimer"></span>
        </div>
        <div class="qbar"><div class="qbar__fill" id="qBar"></div></div>
        <h1 class="qtext" id="qText"></h1>
        <div class="qanswers" id="qAnswers"></div>
        <button class="lbtn lbtn--primary qlock" id="qLock" hidden></button>
        <p class="qnote" id="qNote"></p>
    </section>

    {# Guess the Game #}
    <section class="view" id="viewGuess" hidden>
        <div class="qhead">
            <span class="view__eyebrow" id="gNum"></span>
            <span class="qtimer" id="gTimer"></span>
        </div>
        <div class="qbar"><div class="qbar__fill" id="gBar"></div></div>
        <img class="gpic" id="gImg" alt="">
        <form class="gform" id="gForm" autocomplete="off">
            <input class="linput" name="text" placeholder="Welches Spiel ist das?" maxlength="60" autocapitalize="off" autocorrect="off" spellcheck="false">
            <button class="lbtn lbtn--primary" type="submit" id="gSend">Tippen</button>
        </form>
        <p class="qnote" id="gNote"></p>
    </section>

    {# Guess the Price #}
    <section class="view" id="viewPrice" hidden>
        <div class="qhead">
            <span class="view__eyebrow" id="pNum"></span>
            <span class="qtimer" id="pTimer"></span>
        </div>
        <div class="qbar"><div class="qbar__fill" id="pBar"></div></div>
        <img class="ppic" id="pImg" alt="">
        <h1 class="qtext" id="pName"></h1>
        <form class="gform" id="pForm" autocomplete="off">
            <input class="linput" name="text" placeholder="Preis in €, z. B. 1.250 oder 430 Mio" maxlength="40" inputmode="decimal" autocorrect="off" spellcheck="false">
            <p class="ppreview" id="pPreview"></p>
            <button class="lbtn lbtn--primary" type="submit" id="pSend">Tippen</button>
        </form>
        <p class="qnote" id="pNote"></p>
    </section>

    {# Awards #}
    <section class="view" id="viewAwards" hidden>
        <p class="view__eyebrow">Award-Verleihung</p>
        <h1 class="view__title">Wer bekommt welchen Award?</h1>
        <div class="aw-list" id="awList"></div>
        <p class="qnote" id="awNote"></p>
    </section>
</main>

<script src="{{ lan_asset('quiz.js') }}"></script>
</body>
</html>
