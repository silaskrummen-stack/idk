{# Fallback für alle Fehlerseiten ohne eigenes Template (500, 403 …); error404.html.twig erweitert dieses #}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ status_code }} — silas-krummen.de</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
    <style>
        .error-page {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .error-page .hero__title {
            max-width: 18ch;
        }
    </style>
</head>
<body>
<main class="error-page">
    <section class="hero">
        <p class="hero__eyebrow">{% block eyebrow %}$ exit {{ status_code }}{% endblock %}</p>
        <h1 class="hero__title">{% block heading %}Da ist etwas schiefgelaufen.{% endblock %}</h1>
        <p class="hero__subtitle">
            {% block message %}
                Das liegt nicht an dir. Versuch es gleich noch einmal, oder schreib mir an
                <a href="mailto:silas.krummen@web.de">silas.krummen@web.de</a>.
            {% endblock %}
        </p>
        <div class="hero__actions">
            <a href="/" class="btn btn--primary">Zur Startseite</a>
        </div>
    </section>
</main>
</body>
</html>
