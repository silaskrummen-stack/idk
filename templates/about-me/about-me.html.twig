{% block javascripts %}
<script>
// Werdegang: Station oben wählen, Text darunter wechselt. Pfeiltasten wie bei Tabs.
document.querySelectorAll('[data-journey]').forEach(function (journey) {
    var rail = journey.querySelector('.journey__rail');
    var stops = Array.prototype.slice.call(journey.querySelectorAll('.journey__stop'));

    function select(index, focus) {
        stops.forEach(function (stop, i) {
            var isSelected = i === index;
            stop.setAttribute('aria-selected', String(isSelected));
            stop.tabIndex = isSelected ? 0 : -1;
            stop.classList.toggle('is-passed', i < index);
            document.getElementById(stop.getAttribute('aria-controls')).hidden = !isSelected;
        });
        rail.style.setProperty('--progress', index / (stops.length - 1));
        if (focus) stops[index].focus({ preventScroll: true });
    }

    stops.forEach(function (stop, index) {
        stop.addEventListener('click', function () {
            select(index, false);
        });
        stop.addEventListener('keydown', function (e) {
            var next = null;
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = Math.min(index + 1, stops.length - 1);
            if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = Math.max(index - 1, 0);
            if (e.key === 'Home') next = 0;
            if (e.key === 'End') next = stops.length - 1;
            if (next === null) return;
            e.preventDefault();
            select(next, true);
        });
    });

    // "Weiter"-Knöpfe stehen in Panel 0 … n-2, der i-te führt also zu Station i+1
    journey.querySelectorAll('[data-journey-next]').forEach(function (button, index) {
        button.addEventListener('click', function () {
            select(index + 1, true);
        });
    });
});

// Hobbys: Karte antippen dreht Symbol und Text
document.querySelectorAll('[data-hobby-card]').forEach(function (card) {
    card.addEventListener('click', function () {
        card.setAttribute('aria-expanded', String(card.getAttribute('aria-expanded') !== 'true'));
    });
});

// Stärken: Klick zeigt ein Beispiel darunter, immer nur eins auf einmal
document.querySelectorAll('[data-strengths]').forEach(function (list) {
    var tags = Array.prototype.slice.call(list.querySelectorAll('[aria-controls]'));
    tags.forEach(function (tag) {
        tag.addEventListener('click', function () {
            var open = tag.getAttribute('aria-expanded') !== 'true';
            tags.forEach(function (t) {
                var isOpen = t === tag && open;
                t.setAttribute('aria-expanded', String(isOpen));
                document.getElementById(t.getAttribute('aria-controls')).hidden = !isOpen;
            });
        });
    });
});

// KI-Bereich: links gewählter Eintrag bestimmt den Text rechts
document.addEventListener('DOMContentLoaded', function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.about-ai__tab'));
    if (!tabs.length) return;

    function selectTab(tab, focus) {
        tabs.forEach(function (t) {
            var isSelected = t === tab;
            t.setAttribute('aria-selected', String(isSelected));
            t.tabIndex = isSelected ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = !isSelected;
        });
        if (focus) tab.focus();
    }

    tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () {
            selectTab(tab, false);
        });
        tab.addEventListener('keydown', function (e) {
            var next = null;
            if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
            if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
            if (e.key === 'Home') next = tabs[0];
            if (e.key === 'End') next = tabs[tabs.length - 1];
            if (!next) return;
            e.preventDefault();
            selectTab(next, true);
        });
    });

    // Erst das Fazit, der ganze Text auf Wunsch. Gilt für alle Einträge gemeinsam,
    // damit die Höhe beim Umschalten der Tabs gleich bleibt.
    var ai = document.querySelector('.about-ai');
    var toggles = Array.prototype.slice.call(ai.querySelectorAll('[data-ai-toggle]'));
    toggles.forEach(function (toggle) {
        toggle.addEventListener('click', function () {
            var expanded = !ai.classList.contains('is-expanded');
            ai.classList.toggle('is-expanded', expanded);
            toggles.forEach(function (t) {
                t.setAttribute('aria-expanded', String(expanded));
                t.textContent = expanded ? 'Weniger anzeigen' : 'Ganzen Text lesen';
            });
            // Beim Zuklappen nicht irgendwo unterhalb des Abschnitts landen
            if (!expanded && ai.getBoundingClientRect().top < 0) {
                ai.scrollIntoView({ block: 'start' });
            }
        });
    });
});
</script>
{% endblock %}
