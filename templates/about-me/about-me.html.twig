            <div class="journey" data-journey>
                <div class="journey__rail" role="tablist" aria-label="Stationen meines Werdegangs" style="--progress: 0">
                    <span class="journey__progress" aria-hidden="true"></span>
                    {% for station in stations %}
                        <button type="button" class="journey__stop" role="tab" id="journey-tab-{{ loop.index0 }}" aria-controls="journey-panel-{{ loop.index0 }}" aria-selected="{{ loop.first ? 'true' : 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>
                            <span class="journey__dot" aria-hidden="true"></span>
                            <span class="journey__year">{{ station.year }}</span>
                            <span class="journey__label">{{ station.label }}</span>
                        </button>
                    {% endfor %}
                </div>

                <div class="journey__body">
                    <div class="werdegang-photo journey__photo">
                        <img src="/pictures/silas-9.webp" alt="Silas Krummen">
                    </div>

                    {# Alle Texte liegen übereinander, damit die Höhe beim Umschalten gleich bleibt #}
                    <div class="journey__panels">
                        {% for station in stations %}
                            <div class="journey__panel" role="tabpanel" id="journey-panel-{{ loop.index0 }}" aria-labelledby="journey-tab-{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
