<script>
document.addEventListener('DOMContentLoaded', function () {
    var track = document.querySelector('.werdegang-timeline__track');
    if (!track) return;
    var items = track.querySelectorAll('.timeline-item');

    function selectItem(item, smooth) {
        items.forEach(function (i) { i.classList.remove('is-selected'); });
        item.classList.add('is-selected');
        item.scrollIntoView({
            behavior: smooth ? 'smooth' : 'auto',
            inline: 'center',
            block: 'nearest'
        });
    }

    items.forEach(function (item) {
        item.addEventListener('click', function () {
            selectItem(item, true);
        });
    });

    var initial = track.querySelector('.timeline-item.is-selected') || items[items.length - 1];
    // slight delay so layout is settled before we scroll
    requestAnimationFrame(function () {
        selectItem(initial, false);
    });
});
</script>

