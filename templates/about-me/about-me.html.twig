{% extends 'base.html.twig' %}

{% block title %}Über mich — Portfolio{% endblock %}

{# Parallax-Hintergrund: Symbole unter /pictures/parallax/, kreuz und quer über die Seite verteilt.
   Drei Tiefenebenen: nah = deutlich, schnell, am Rand; fern = riesig, blass, langsam, auch mitten hinter dem Inhalt.
   Die Listen unten haben bewusst unterschiedliche Längen, damit sich kein Muster wiederholt. #}
{% block parallax %}
    {% set symbols = ['code', 'd20', 'terminal', 'gamepad', 'wifi', 'pixel-heart', 'git', 'coffee', 'braces', 'wasd', 'globe',
        'pixel-alien', 'chip', 'trophy', 'cursor', 'headset', 'bug', 'cloud', 'sword', 'floppy', 'pixel-coin'] %}
    {% set depths = {
        near: {size: 104, speed: 0.75, opacity: 0.28},
        mid:  {size: 140, speed: 0.5,  opacity: 0.17},
        far:  {size: 220, speed: 0.25, opacity: 0.09},
    } %}
    {% set depth_order = ['near', 'far', 'mid', 'far', 'near', 'mid', 'far'] %}
    {# nahe Symbole bleiben am Rand, damit sie den Text nicht stören #}
    {% set x_edge = [2, 88, 9, 80, 4, 91, 14, 84, 0, 77, 11] %}
    {% set x_anywhere = [12, 47, 70, 28, 85, 5, 60, 38, 92, 20, 52, 78, 33] %}
    {% set jitter = [0, 0.4, -0.3, 0.2, -0.45] %}
    {% set offsets = [0.1, 0.62, 0.3, 0.85, 0.05, 0.45, 0.72, 0.2, 0.9, 0.38, 0.58] %}
    {% set rotations = [-35, 20, -10, 40, -25, 12, 30] %}
    {% set spins = [-18, 12, 25, -9, 15, -22] %}
    {% set last = symbols|length - 1 %}
    {% set items = [] %}
    {% for symbol in symbols %}
        {% set i = loop.index0 %}
        {% set depth = depth_order[i % depth_order|length] %}
        {% set items = items|merge([{
            symbol: symbol,
            depth: depth,
            x: depth == 'near' ? x_edge[i % x_edge|length] : x_anywhere[i % x_anywhere|length],
            at: max(0, min(1, (i + jitter[i % jitter|length]) / last)),
            offset: offsets[i % offsets|length],
            rotate: rotations[i % rotations|length],
            spin: spins[i % spins|length],
        }]) %}
    {% endfor %}
    {# Von Hand gesetzt: Lücken oben rechts (at 0 = beim Laden sichtbar) und am Seitenende (at 1) #}
    {% set items = items|merge([
        {symbol: 'server',      depth: 'far',  x: 70, at: 0,    offset: 0.06, rotate: -14, spin: 10},
        {symbol: 'rocket',      depth: 'near', x: 89, at: 0,    offset: 0.4,  rotate: 28,  spin: -15},
        {symbol: 'hash',        depth: 'mid',  x: 79, at: 0.02, offset: 0.68, rotate: -22, spin: 14},
        {symbol: 'pixel-heart', depth: 'mid',  x: 61, at: 0,    offset: 0.02, rotate: 12,  spin: -10},
        {symbol: 'joystick',    depth: 'near', x: 77, at: 0.06, offset: 0.14, rotate: -8,  spin: 20},
        {symbol: 'trophy',      depth: 'near', x: 6,  at: 1,    offset: 0.55, rotate: -18, spin: 12},
        {symbol: 'd20',         depth: 'mid',  x: 83, at: 0.97, offset: 0.78, rotate: -30, spin: 18},
        {symbol: 'pixel-alien', depth: 'near', x: 90, at: 1,    offset: 0.22, rotate: 10,  spin: -14},
        {symbol: 'wifi',        depth: 'mid',  x: 21, at: 0.95, offset: 0.86, rotate: 35,  spin: -20},
        {symbol: 'cloud',       depth: 'far',  x: 30, at: 1,    offset: 0.62, rotate: -6,  spin: 9},
        {symbol: 'gamepad',     depth: 'near', x: 80, at: 0.93, offset: 0.5,  rotate: 16,  spin: -12},
    ]) %}
    <div class="parallax" aria-hidden="true" data-parallax>
        {% for item in items %}
            {% set depth = depths[item.depth] %}
            <img class="parallax__symbol" src="/pictures/parallax/{{ item.symbol }}.svg" alt="" width="{{ depth.size }}" height="{{ depth.size }}"
                 style="--x: {{ item.x }}%; --size: {{ depth.size }}px; --opacity: {{ depth.opacity }}; --rotate: {{ item.rotate }}deg"
                 data-at="{{ item.at|round(3) }}" data-offset="{{ item.offset }}" data-speed="{{ depth.speed }}" data-spin="{{ item.spin }}"
                 decoding="async">
        {% endfor %}
    </div>
{% endblock %}

