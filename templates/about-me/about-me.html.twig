{% extends 'base.html.twig' %}

{% block title %}Über mich — Portfolio{% endblock %}

{% block body %}
    {% set skill_groups = {
        'Backend': {'PHP': 3, 'Java': 1, 'C#': 1},
        'Frontend': {'Java/-TypeScript': 3, 'HTML / CSS': 2, 'Twig': 2},
        'Datenhandling': {'MySQL': 3, 'GraphQL': 1, 'SPSS': 1},
        'Sonstiges': {'Microsoft Office': 3, 'Docker': 2, 'GitLab & CI/CD': 2},
    } %}

    <section class="hero" style="padding-bottom: 24px;">
        <span class="hero__eyebrow">whoami --verbose</span>
        <h1 class="hero__title" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">Etwas über mich</h1>
        <p class="hero__subtitle">
            Software- und Systementwickler. Ich baue am liebsten Dinge, die danach auch
            wirklich laufen, von CRM-Integrationen über IoT-Hardware bis zu CI/CD-Pipelines.
        </p>
    </section>

    <div class="container about-page">

        <!-- Profil-Metadaten -->
        <dl class="profile-meta">
            <div class="profile-meta__row">
                <dt>Alter</dt>
                <dd>24</dd>
            </div>
            <div class="profile-meta__row">
                <dt>Aktueller Wohnort</dt>
                <dd>Lingen (Ems)</dd>
            </div>
            <div class="profile-meta__row">
                <dt>Rolle</dt>
                <dd>Full-Stack Web-Developer</dd>
            </div>
        </dl>

        <!-- Werdegang / Narrative -->
        <section class="about-section">
            <h2 class="about-section__title">Werdegang</h2>

            <div class="werdegang-layout">
                <div class="werdegang-photo">
                    <img src="/pictures/silas-9.webp" alt="Silas Krummen">
                </div>

                <div class="werdegang-text">
                    <p class="about-card__text">
                        Aufgewachsen bin ich in Lingen (Ems), wo auch meine Begeisterung für Technik entstanden ist. Angefangen hat alles mit kleinen Bastelprojekten und dem Interesse daran, zu verstehen, wie Computer und Software funktionieren. Mit der Zeit wurden daraus immer anspruchsvollere Projekte, die meinen beruflichen Weg geprägt haben.
                    </p>
                    <p class="about-card__text">
                        Nach meinem Realschulabschluss entschied ich mich für ein Fachabitur mit Schwerpunkt Informatik. Dort konnte ich meine ersten fundierten Kenntnisse in Softwareentwicklung und IT vertiefen. Dort wurde mir klar, dass ich meine berufliche Zukunft im Bereich der Softwareentwicklung sehe und bei der Digitalisierung im Emsland mitwirken wollte.
                    </p>
                    <p class="about-card__text">
                        Im Anschluss begann ich ein Studium der Wirtschaftsinformatik an der Hochschule Osnabrück. Während der sechs Semester konnte ich einen Großteil der Module erfolgreich absolvieren und sowohl technische als auch betriebswirtschaftliche Grundlagen aufbauen. Aus privaten Gründen entschied ich mich dazu, das Studium vorzeitig zu beenden und einen praxisorientierten Weg einzuschlagen.
                    </p>
                    <p class="about-card__text">
                        Mit der Ausbildung zum Fachinformatiker für Anwendungsentwicklung bei der Geocapture GmbH fand ich genau den Einstieg, den ich gesucht hatte. Dort arbeitete ich an realen Kundenprojekten und konnte meine Kenntnisse in der Webentwicklung, Datenbanken und modernen Entwicklungsprozessen kontinuierlich erweitern.
                    </p>
                </div>
            </div>

            <div class="werdegang-timeline" id="werdegangTimeline">
                <div class="werdegang-timeline__track">
                    <button type="button" class="timeline-item" data-index="0">
                        <span class="timeline-item__year">2013</span>
                        <span class="timeline-item__title">Antoniusschule Thuine</span>
                        <span class="timeline-item__panel">
                            <span class="timeline-item__panel-inner">
                                <p class="timeline-item__text">Damals habe ich einen qualifizierten Realschulabschluss mit einem Durchschnitt von 2,4 absolviert</p>
                            </span>
                        </span>
                    </button>
                    <button type="button" class="timeline-item" data-index="1">
                        <span class="timeline-item__year">2018</span>
                        <span class="timeline-item__title">Bockmeyer Zaun & Tor Systeme</span>
                        <span class="timeline-item__panel">
                            <span class="timeline-item__panel-inner">
                                <p class="timeline-item__text">Ein 960h Praktikum im Einzelhandel und Landschaftsbau</p>
                            </span>
                        </span>
                    </button>
                    <button type="button" class="timeline-item" data-index="2">
                        <span class="timeline-item__year">2019</span>
                        <span class="timeline-item__title">BBS Lingen Wirtschaft</span>
                        <span class="timeline-item__panel">
                            <span class="timeline-item__panel-inner">
                                <p class="timeline-item__text">Der Abschluss meines Fachabiturs mit Schwerpunkt auf Informatik und einem Durchschnitt von 2,3 Notenpunkten</p>
                            </span>
                        </span>
                    </button>
                    <button type="button" class="timeline-item" data-index="3">
                        <span class="timeline-item__year">2020</span>
                        <span class="timeline-item__title">Hochschule Osnabrück</span>
                        <span class="timeline-item__panel">
                            <span class="timeline-item__panel-inner">
                                <p class="timeline-item__text">Ein Studium im Bereich Wirtschaftsinformatik für 6 Semester. Trotz &gt;75% abgeschlossener Module, vorzeitiger Abbruch aus privaten Gründen</p>
                            </span>
                        </span>
                    </button>
                    <button type="button" class="timeline-item" data-index="4">
                        <span class="timeline-item__year">2024</span>
                        <span class="timeline-item__title">Geocapture GmbH</span>
                        <span class="timeline-item__panel">
                            <span class="timeline-item__panel-inner">
                                <p class="timeline-item__text">Eine Ausbildung zum Fachinformatiker für Anwendungsentwicklung mit dem Prüfungszeugnis 2 und einem schulischen Durchschnitt von 1,8</p>
                            </span>
                        </span>
                    </button>
                    <button type="button" class="timeline-item is-selected" data-index="5">
                        <span class="timeline-item__year">Heute</span>
                        <span class="timeline-item__title">Full-Stack Web-Developer</span>
                        <span class="timeline-item__panel">
                            <span class="timeline-item__panel-inner">
                                <p class="timeline-item__text">Nun bin ich ein ausgelernter Entwickler, der gespannt ist, was die Zukunft so bietet</p>
                            </span>
                        </span>
                    </button>
                </div>
            </div>
        </section>

        <!-- Fokus & Motivation -->
        <section class="about-section about-statements">
            <div class="about-statement">
                <h2 class="about-statement__title">Fokus</h2>
                <p class="about-statement__text">
                    Am meisten Spaß macht mir die Stelle zwischen Hardware, Infrastruktur und
                    Business-Logik - Systeme, die selbst laufen müssen, nicht nur einmal
                    präsentiert werden.
                </p>
            </div>
            <div class="about-statement about-statement--live">
                <h2 class="about-statement__title">Motivation</h2>
                <p class="about-statement__text">
                    Das, was mich heute auch noch am meisten erfüllt, ist es, langfristige digitale Lösungen für kritische Arbeitsprozesse zu finden, die auch wirklich benutzt werden.
                </p>
            </div>
        </section>

        <!-- Hobbies -->
        <section class="about-section about-card about-hobbies">
            <h2 class="about-section__title">Abseits vom Code</h2>
            <div class="hobby-list">
                <div class="hobby-item">
                    <h3 class="hobby-item__title">Tabletop-RPG</h3>
                    <p class="about-card__text">
                        Ich leite regelmäßig Tabletop-Abende mit Freunden als Dungeon Master,
                        inklusive eigenem Infotainment-Setup mit Musik, Licht und Notizen zur
                        Story sowie eine nonlineare Narrative.
                    </p>
                </div>
                <div class="hobby-item">
                    <h3 class="hobby-item__title">Godot &amp; Gamedev</h3>
                    <p class="about-card__text">
                        Wenn ich mal nicht selber Videospiele spiele, entwickle ich auch mal an einem eigenen 2D-Spiel. Dies ist ein
                        persönliches Herzensprojekt, an dem ich ab und zu weiterarbeite.
                    </p>
                </div>
                <div class="hobby-item">
                    <h3 class="hobby-item__title">Kanu Fahren</h3>
                    <p class="about-card__text">
                        Falls mal gutes Wetter ist, nehme ich oft mein Kanu für Touren an der Ems oder der Hase raus. Das ist auch oft verbunden mit Campen und Wandern.
                    </p>
                </div>
                <div class="hobby-item">
                    <h3 class="hobby-item__title">Gaming</h3>
                    <p class="about-card__text">
                        Ich bin im Herzen noch ein Gamer und Videospiele waren mein erster Kontakt zur Informatik. Heute veranstalte ich noch regelmäßig LAN-Parties.
                    </p>
                </div>
                <div class="hobby-item">
                    <h3 class="hobby-item__title">Bouldern</h3>
                    <p class="about-card__text">
                        Seit der Eröffnung der Boulderhalle in Lingen versuche ich mindestens einmal im Monat eine neue Wand meistern zu können oder mein PR zu brechen.
                    </p>
                </div>
                <div class="hobby-item">
                    <h3 class="hobby-item__title">Videobearbeitung</h3>
                    <p class="about-card__text">
                        Entstand durch das Schneiden von LoL-Highlights und entwickelte sich zu einem Hobby, bei dem ich auch kreative Projekte für Bekannte unterstütze.
                    </p>
                </div>
            </div>

            <h3 class="about-subtitle">Medienbearbeitung</h3>
            <div class="tool-list">
                <a href="https://www.audacityteam.org" class="tool-item" target="_blank" rel="noopener noreferrer">
                    <img src="/pictures/about-me/audacity.png" alt="">
                    <span>Audacity</span>
                </a>
                <a href="https://www.gimp.org" class="tool-item" target="_blank" rel="noopener noreferrer">
                    <img src="/pictures/about-me/gimp.png" alt="">
                    <span>Gimp</span>
                </a>
                <a href="https://inkscape.org" class="tool-item" target="_blank" rel="noopener noreferrer">
                    <img src="/pictures/about-me/inkscape.png" alt="">
                    <span>Inkscape</span>
                </a>
                <a href="https://www.blackmagicdesign.com/de/products/davinciresolve/" class="tool-item" target="_blank" rel="noopener noreferrer">
                    <img src="/pictures/about-me/davinciresolve.png" alt="">
                    <span>Davinci Resolve</span>
                </a>
            </div>
        </section>

        <!-- Werkzeuge & Kompetenzen -->
        <section class="about-section">
            <h2 class="about-section__title">Werkzeuge &amp; Kompetenzen</h2>

            <div class="about-tools">
                <div class="about-card">
                    <h3 class="about-card__title">Kompetenzen</h3>
                    <div class="skill-groups">
                        {% for group, skills in skill_groups %}
                            <div class="skill-group">
                                <span class="skill-group__title">{{ group }}</span>
                                <ul class="skill-list">
                                    {% for name, level in skills %}
                                        <li class="skill-item">
                                            <span class="skill-item__name">{{ name }}</span>
                                            <span class="skill-item__dots" aria-label="{{ level }} von 5">
                                                {% for i in 1..5 %}
                                                    <span class="dot{{ i <= level ? ' is-filled' : '' }}"></span>
                                                {% endfor %}
                                            </span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="about-tools__side">
                    <div class="about-card">
                        <h3 class="about-card__title">Stack</h3>
                        <div class="tag-list">
                            <span class="tag">PHP / Symfony</span>
                            <span class="tag">C# / .NET</span>
                            <span class="tag">Angular</span>
                            <span class="tag">Docker</span>
                            <span class="tag">LoRaWAN / IoT</span>
                            <span class="tag">CI/CD</span>
                        </div>
                    </div>

                    <div class="about-card">
                        <h3 class="about-card__title">Frameworks</h3>
                        <div class="tool-list">
                            <a href="https://symfony.com" class="tool-item" target="_blank" rel="noopener noreferrer">
                                <img src="/pictures/about-me/symfony.png" alt="">
                                <span>Symfony</span>
                            </a>
                            <a href="https://angular.dev" class="tool-item" target="_blank" rel="noopener noreferrer">
                                <img src="/pictures/about-me/angular.png" alt="">
                                <span>Angular</span>
                            </a>
                            <a href="https://react.dev" class="tool-item" target="_blank" rel="noopener noreferrer">
                                <img src="/pictures/about-me/react.png" alt="">
                                <span>React</span>
                            </a>
                        </div>
                    </div>

                    <div class="about-card">
                        <h3 class="about-card__title">DevOps</h3>
                        <div class="tool-list">
                            <a href="https://www.docker.com" class="tool-item" target="_blank" rel="noopener noreferrer">
                                <img src="/pictures/about-me/docker.png" alt="">
                                <span>Docker</span>
                            </a>
                            <a href="https://about.gitlab.com/de-de/" class="tool-item" target="_blank" rel="noopener noreferrer">
                                <img src="/pictures/about-me/gitlab.png" alt="">
                                <span>GitLab</span>
                            </a>
                            <a href="https://www.redhat.com/de/topics/devops/what-is-ci-cd" class="tool-item" target="_blank" rel="noopener noreferrer">
                                <img src="/pictures/about-me/cicd.png" alt="">
                                <span>CI/CD</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Fremdsprachen & Stärken -->
        <section class="about-section about-grid">
            <div class="about-card">
                <h3 class="about-card__title">Fremdsprachen</h3>
                <ul class="lang-list">
                    <li class="lang-item">
                        <span class="lang-item__name">Deutsch</span>
                        <span class="lang-item__level">C2 / Native Tongue</span>
                    </li>
                    <li class="lang-item">
                        <span class="lang-item__name">Englisch</span>
                        <span class="lang-item__level">C2 / Master Proficiency</span>
                    </li>
                    <li class="lang-item">
                        <span class="lang-item__name">Spanisch</span>
                        <span class="lang-item__level">A2 / Elementary</span>
                    </li>
                </ul>
            </div>

            <div class="about-card">
                <h3 class="about-card__title">Stärken</h3>
                <div class="tag-list">
                    <span class="tag">Hilfsbereitschaft</span>
                    <span class="tag">Analytisches Denken</span>
                    <span class="tag">Flexibilität</span>
                    <span class="tag">Kundenorientierung</span>
                    <span class="tag">Kreativität</span>
                    <span class="tag">Lernbereitschaft</span>
                    <span class="tag">Kommunikationsfähigkeit</span>
                </div>
            </div>

            <div class="about-card">
                <h3 class="about-card__title">Mobilität</h3>
                <p class="about-card__text">
                    Am liebsten bin ich mit dem Fahrrad oder der Bahn unterwegs. Beruflich bin ich in der
                    Vergangenheit aber auch viel mit meinem eigenen Auto gefahren, etwa zu Kunden, und bin
                    dazu auch in Zukunft gerne bereit.
                </p>
                <div class="tag-list about-card__tags">
                    <span class="tag">Fahrrad</span>
                    <span class="tag">Bahn</span>
                    <span class="tag">Führerschein Klasse B</span>
                    <span class="tag">Eigenes Auto</span>
                </div>
            </div>
        </section>

        <!-- Benutzung von KI -->
        <section class="about-section">
            <h2 class="about-section__title">Benutzung von KI</h2>

            <div class="about-ai">
                <div class="about-ai__list" role="tablist" aria-label="Benutzung von KI" aria-orientation="vertical">
                    <button type="button" class="tool-item about-ai__tab" role="tab" id="ai-tab-statement" aria-controls="ai-panel-statement" aria-selected="true">
                        <span>Statement</span>
                    </button>
                    <button type="button" class="tool-item about-ai__tab" role="tab" id="ai-tab-claude" aria-controls="ai-panel-claude" aria-selected="false" tabindex="-1">
                        <img src="/pictures/about-me/claude.png" alt="" onerror="this.remove()">
                        <span>Claude</span>
                    </button>
                    <button type="button" class="tool-item about-ai__tab" role="tab" id="ai-tab-copilot" aria-controls="ai-panel-copilot" aria-selected="false" tabindex="-1">
                        <img src="/pictures/about-me/copilot.png" alt="" onerror="this.remove()">
                        <span>Microsoft Copilot</span>
                    </button>
                    <button type="button" class="tool-item about-ai__tab" role="tab" id="ai-tab-chatgpt" aria-controls="ai-panel-chatgpt" aria-selected="false" tabindex="-1">
                        <img src="/pictures/about-me/chatgpt.png" alt="" onerror="this.remove()">
                        <span>ChatGPT</span>
                    </button>
                </div>

                <div class="about-essay about-ai__panel" role="tabpanel" id="ai-panel-statement" aria-labelledby="ai-tab-statement" tabindex="0">
                    <p>
                        Ich sehe die zunehmende Verbreitung von KI im Berufs- und Privatleben mit klaren ethischen
                        Bedenken und engagiere mich politisch für mehr Regulierung vor allem im kreativen Bereich. Sprachmodelle erzeugen im eigentlichen Sinne nichts Neues: Sie Re-Hashen rechtlich dubios ergatterte Trainingssets. Deshalb tendieren
                        ihre Ergebnisse zum Durchschnitt. Wer Gestaltung allein nach gelernten UI-Prinzipien erzeugen
                        lässt, bekommt Seiten, die alle irgendwie gleich aussehen. Geschmack, Haltung und echten
                        menschlichen Kontakt wird es auch in Zukunft nicht ersetzen.
                    </p>
                    <p>
                        Beruflich halte ich eine komplette Ablehnung trotzdem nicht für tragbar, erst recht nicht in
                        der IT. Ende 2025 ist mir klar geworden, dass Ignoranz keine nachhaltige Haltung ist: Unternehmen, die nicht mitziehen, werden durch die ersetzt, die es tun. Genau da sehe ich meine Arbeit: Unternehmen dabei helfen, im technologischen Rennen mitzuhalten. Begeistern kann ich mich für Einsätze, die der Gemeinschaft nützen und repetitive,
                        fehleranfällige Arbeit abnehmen.
                    </p>
                    <p>
                        Bei der Qualitätssicherung von KI-Projekten habe ich oft mitgewirkt, und meine eigenen
                        Projekte zeigen ein klares Muster: Die Qualität hängt weniger am Modell als an der
                        Spezifikation. Mit klaren Anforderungen, vorgegebener Architektur und konsequentem Review
                        entstehen gute Ergebnisse. Arbeitet ein Modell ohne diese Leitplanken, wächst der Code schnell
                        und wird schwer wartbar.
                    </p>
                    <p>
                        Ein Thema, das aus meiner Sicht noch unterschätzt wird, ist Token-Management. Viele
                        mittelständische Unternehmen bauen ihre Prozesse gerade auf den heutigen Preisen auf, und ich
                        gehe fest davon aus, dass diese steigen werden. Dann wird jeder unbedachte Agenten-Workflow
                        zum laufenden Kostenfaktor. Wer KI einführt, sollte deshalb den Verbrauch pro Prozess messen,
                        für jede Aufgabe das kleinste ausreichende Modell wählen und Prozesse so bauen, dass sie nicht
                        von einem einzigen Anbieter abhängen. Sonst entstehen technische Altlasten, wie ich sie in
                        meiner Karriere schon mehrmals erlebt habe.
                    </p>
                </div>
                <div class="about-essay about-ai__panel" role="tabpanel" id="ai-panel-claude" aria-labelledby="ai-tab-claude" tabindex="0" hidden>
                    <p>
                        Claude und Claude Code nutze ich vor allem für professionelle Arbeit, also überall dort, wo das Ergebnis wirklich zählt. Claude versteht gut, was ich eigentlich will, auch wenn ich es nicht bis ins letzte Detail ausformuliere. Die Codequalität ist sehr gut, nur bei Konventionen und Standards braucht es klare Vorgaben.
                    </p>
                    <p>
                        Auffällig ist, wie viel Claude mitdenkt. Fallbacks und Randfälle baut es von sich aus ein, und wenn eine Änderung Stellen im Code betrifft, die ich selbst gar nicht im Blick hatte, findet es diese und passt sie gleich mit an.
                    </p>
                    <p>
                        Stark ist es auch beim Testen: Entweder baut es sich eine eigene Testumgebung auf, oder es nutzt die, die ich ihm vorgebe, und prüft seine Änderungen, bevor es sie als fertig meldet.
                    </p>
                    <p>
                        Ich nutze Claude mit dem Pro-Plan für sehr viele Aufgaben und bin dabei bisher nie an die Nutzungsgrenzen gestoßen. Über die Zeit habe ich mir eigene Skills aufgebaut, zum Beispiel für SEO, für rechtliche Anforderungen an Websites wie Impressum und Datenschutz und um schwache Formulierungen in Texten zu finden.
                    </p>
                    <p>
                        Privat habe ich mit Claude ganze Spiele nach meinen Wünschen gemoddet, Spiele nachträglich um einen Mehrspielermodus erweitert und alte Spiele aus der Zeit um 2010 dekompiliert, damit sie auf moderner Hardware laufen, für mich selbst und für unsere LAN-Partys.
                    </p>
                </div>
                <div class="about-essay about-ai__panel" role="tabpanel" id="ai-panel-copilot" aria-labelledby="ai-tab-copilot" tabindex="0" hidden>
                    <p>
                        Microsoft Copilot ist mir in verschiedenen Unternehmen immer wieder begegnet. Wirklich überzeugt hat es mich aber nur innerhalb einer Microsoft-365-Umgebung.
                    </p>
                    <p>
                        Dort spielt es seine größte Stärke aus: den Zugriff auf den Kontext des Unternehmens. Copilot kennt E-Mails, Teams-Besprechungen und Dokumente in SharePoint und OneDrive. Darauf aufbauend fasst es Besprechungen zusammen, schreibt Entwürfe in Word oder wertet Tabellen in Excel aus, und zwar innerhalb der Berechtigungen, die im Unternehmen ohnehin gelten.
                    </p>
                    <p>
                        Besonders gut ist es bei Problemen mit Microsoft selbst. Fragen zu Excel-Formeln, Teams-Einstellungen, Power Automate oder Fehlermeldungen in Windows beantwortet es oft schneller und treffender als andere Assistenten.
                    </p>
                    <p>
                        Außerhalb dieses Ökosystems verliert es für mich deutlich an Wert. Für Unternehmen ist Copilot deshalb vor allem eine strategische Entscheidung: Wer bereit ist, sich langfristig an Microsoft zu binden, bekommt ein wirklich nützliches Werkzeug, das sich nahtlos in die bestehende Arbeit einfügt. Wer Wert auf Unabhängigkeit legt, sollte diese Abhängigkeit vorher bewusst abwägen.
                    </p>
                </div>
                <div class="about-essay about-ai__panel" role="tabpanel" id="ai-panel-chatgpt" aria-labelledby="ai-tab-chatgpt" tabindex="0" hidden>
                    <p>
                        ChatGPT nutze ich vor allem für Kommunikation und für Privates. Beruflich formuliere ich damit E-Mails um und lasse mir Nachrichten an Kunden gegenlesen, bevor ich sie abschicke: Passt der Ton, ist die Kernaussage klar, könnte etwas missverstanden werden?
                    </p>
                    <p>
                        Privat ist es mein Werkzeug für fast alles Alltägliche, vom Kochen bis zur Recherche zu Themen, die keine wissenschaftliche Tiefe brauchen.
                    </p>
                    <p>
                        Für besonders klug halte ich ChatGPT nicht, bei komplexen technischen Aufgaben greife ich zu Claude. Dafür ist es freundlich, einfach zu bedienen, kostet in der Basisversion praktisch nichts und nennt bei Recherchen seine Quellen, sodass ich Aussagen selbst überprüfen kann. Für die meisten Alltagsfragen ist genau das wichtiger als maximale Intelligenz.
                    </p>
                </div>
            </div>
        </section>

        <div class="hero__actions about-page__actions">
            <a href="mailto:silas.krummen@web.de" class="btn btn--primary">Kontakt aufnehmen</a>
            <a href="{{ path('project_dashboard') }}" class="btn btn--ghost">Projekte ansehen</a>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var track = document.querySelector('.werdegang-timeline__track');
    if (!track) return;
    var items = track.querySelectorAll('.timeline-item');

    function selectItem(item, smooth) {
        items.forEach(function (i) { i.classList.remove('is-selected'); });
        item.classList.add('is-selected');
        item.scrollIntoView({
            behavior: smooth ? 'smooth' : 'auto',
            inline: 'center',
            block: 'nearest'
        });
    }

    items.forEach(function (item) {
        item.addEventListener('click', function () {
            selectItem(item, true);
        });
    });

    var initial = track.querySelector('.timeline-item.is-selected') || items[items.length - 1];
    // slight delay so layout is settled before we scroll
    requestAnimationFrame(function () {
        selectItem(initial, false);
    });
});

// KI-Bereich: links gewählter Eintrag bestimmt den Text rechts
document.addEventListener('DOMContentLoaded', function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.about-ai__tab'));
    if (!tabs.length) return;

    function selectTab(tab, focus) {
        tabs.forEach(function (t) {
            var isSelected = t === tab;
            t.setAttribute('aria-selected', String(isSelected));
            t.tabIndex = isSelected ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = !isSelected;
        });
        if (focus) tab.focus();
    }

    tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () {
            selectTab(tab, false);
        });
        tab.addEventListener('keydown', function (e) {
            var next = null;
            if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
            if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
            if (e.key === 'Home') next = tabs[0];
            if (e.key === 'End') next = tabs[tabs.length - 1];
            if (!next) return;
            e.preventDefault();
            selectTab(next, true);
        });
    });
});
</script>
{% endblock %}
