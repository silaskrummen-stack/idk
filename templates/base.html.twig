<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Portfolio{% endblock %}</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/js/lenis/lenis.css">
    <link rel="stylesheet" href="/css/app.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{# Parallax-Hintergrund, gesteuert von /js/scroll.js. Seiten können vorab parallax_images setzen. #}
{% block parallax %}
    {% set parallax_images = parallax_images|default([
        '/pictures/projects/lan.jpg',
        '/pictures/projects/civ.jpg',
        '/pictures/projects/krummen.jpg',
        '/pictures/projects/rage.jpg',
        '/pictures/projects/klima.jpg',
        '/pictures/projects/dg.jpg',
    ]) %}
    <div class="parallax" aria-hidden="true" data-parallax>
        {% for src in parallax_images %}
            <img class="parallax__img" src="{{ src }}" alt="" data-speed="{{ loop.index is odd ? '0.45' : '0.6' }}" {% if not loop.first %}loading="lazy" {% endif %}decoding="async">
        {% endfor %}
    </div>
{% endblock %}

<nav class="site-nav">
    <a href="{{ path('homepage') }}" class="site-nav__logo">system.log</a>
    <ul class="site-nav__links">
        <li><a href="{{ path('homepage') }}">Start</a></li>
        <li><a href="{{ path('about_me') }}">Über mich</a></li>
        {% set current_route = app.request.attributes.get('_route') %}
        <li class="site-nav__dropdown" data-nav-dropdown>
            <button
                type="button"
                class="site-nav__dropdown-toggle {{ current_route starts with 'project' ? 'is-active' }}"
                aria-expanded="false"
                aria-controls="nav-projects"
                data-nav-dropdown-toggle
            >
                Projekte
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <ul class="site-nav__submenu" id="nav-projects">
                <li>
                    <a href="{{ path('project_dashboard') }}" class="{{ current_route == 'project_dashboard' ? 'is-active' }}">
                        Alle Projekte
                        <small>Projekt-Log</small>
                    </a>
                </li>
                <li class="site-nav__submenu-divider" role="separator"></li>
                <li>
                    <a href="{{ path('project_lan_party') }}" class="{{ current_route == 'project_lan_party' ? 'is-active' }}">
                        LAN-Party Moderation
                        <small>privat · 10/2026</small>
                    </a>
                </li>
                <li>
                    <a href="{{ path('project_civ_abend') }}" class="{{ current_route == 'project_civ_abend' ? 'is-active' }}">
                        CIV-Abend Spielleitung
                        <small>privat · 09/2026</small>
                    </a>
                </li>
                <li>
                    <a href="{{ path('project_krummen') }}" class="{{ current_route == 'project_krummen' ? 'is-active' }}">
                        krummen.de
                        <small>produktiv · 09/2026</small>
                    </a>
                </li>
            </ul>
        </li>
        <li><a href="{{ path('documents') }}">Dokumente</a></li>
        <li><a href="{{ path('contact') }}">Kontakt</a></li>
    </ul>
</nav>

{% block body %}{% endblock %}

<footer class="site-footer">
     &copy; {{ "now"|date("Y") }} — An einem Wochenende programmiert mit 
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -2px;">
        <path d="M12 21s-6.716-4.35-9.428-8.14C.55 10.29 1.1 6.5 4.5 5.1 7 4.06 9.5 5 12 8c2.5-3 5-3.94 7.5-2.9 3.4 1.4 3.95 5.19 1.928 7.76C18.716 16.65 12 21 12 21z"/>
    </svg>
</footer>

{% block javascripts %}{% endblock %}

<script src="/js/lenis/lenis.min.js" defer></script>
<script src="/js/scroll.js" defer></script>
<script>

    // Projekte-Dropdown: Hover öffnet es per CSS, der Button ist für Touch und Tastatur
    document.querySelectorAll('[data-nav-dropdown]').forEach((dropdown) => {
        const toggle = dropdown.querySelector('[data-nav-dropdown-toggle]');
        const setOpen = (open) => {
            dropdown.classList.toggle('is-open', open);
            toggle.setAttribute('aria-expanded', String(open));
        };

        toggle.addEventListener('click', () => setOpen(!dropdown.classList.contains('is-open')));
        document.addEventListener('click', (e) => {
            if (!dropdown.contains(e.target)) setOpen(false);
        });
        dropdown.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                setOpen(false);
                toggle.focus();
            }
        });
    });

    document.querySelectorAll('[data-project-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const card = btn.closest('[data-project-card]');
            const isOpen = card.classList.toggle('is-open');

            btn.setAttribute('aria-expanded', String(isOpen));
            btn.querySelector('[data-label-open]').hidden = isOpen;
            btn.querySelector('[data-label-close]').hidden = !isOpen;
        });
    });
</script>
</body>
</html>
